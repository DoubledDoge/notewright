<Application
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="Notewright.UI.App"
	RequestedThemeVariant="Dark"
>
	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#4ade80" />
			<Setter Property="Foreground" Value="#0a0a0a" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>

		<Style Selector="Button.primary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#22c55e" />
		</Style>

		<Style Selector="Button.secondary, ToggleButton.secondary">
			<Setter Property="Background" Value="#2a2a2a" />
			<Setter Property="Foreground" Value="#cccccc" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="BorderBrush" Value="#3a3a3a" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style Selector="Button.secondary:pointerover /template/ ContentPresenter, ToggleButton.secondary:pointerover /template/ ContentPresenter, ToggleButton.secondary:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="#333333" />
			<Setter Property="Foreground" Value="#ffffff" />
		</Style>

		<Style Selector="Button.ghost">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="#666666" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1a1a1a" />
		</Style>

		<Style Selector="Button.tab">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="#666666" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style Selector="Button.tab.active">
			<Setter Property="Background" Value="#2a2a2a" />
			<Setter Property="Foreground" Value="#ffffff" />
		</Style>

		<Style Selector="Button.control">
			<Setter Property="Background" Value="#2a2a2a" />
			<Setter Property="Foreground" Value="#cccccc" />
			<Setter Property="Padding" Value="6,4" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="MinWidth" Value="24" />
		</Style>
	</Application.Styles>
</Application>
