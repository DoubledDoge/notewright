<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Notewright.UI.ViewModels"
	x:Class="Notewright.UI.Views.Settings.HotkeySettingsView"
	x:DataType="vm:SettingsViewModel"
	xmlns:settings="using:Notewright.UI.Views.Settings"
>
	<Grid RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" Padding="24">
			<StackPanel Spacing="24">
				<StackPanel Spacing="4">
					<TextBlock
						Text="Keyboard &amp; hotkeys"
						Foreground="#ffffff"
						FontSize="20"
						FontWeight="Bold"
					/>
					<TextBlock
						Text="Choose the keys that control playback. Each key works only in the mode noted beneath it, and only while Notewright isn’t the focused window."
						Foreground="#666666"
						FontSize="12"
						TextWrapping="Wrap"
					/>
				</StackPanel>

				<ItemsControl ItemsSource="{Binding Editors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="16" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:HotkeyEditorViewModel">
							<settings:HotkeyEditorView />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<Border
			Grid.Row="1"
			Background="#111111"
			BorderBrush="#2a2a2a"
			BorderThickness="0,1,0,0"
			Padding="16,12"
		>
			<DockPanel>
				<Button DockPanel.Dock="Left" Command="{Binding NavigateBackCommand}" Classes="ghost">
					← Back to player
				</Button>

				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
					<Button Command="{Binding CancelCommand}" Classes="secondary">Cancel</Button>
					<Button Command="{Binding SaveAllCommand}" Classes="primary">✓ Save changes</Button>
				</StackPanel>

				<StackPanel
					Orientation="Horizontal"
					Spacing="6"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
				>
					<TextBlock Text="⊙" Foreground="#444444" FontSize="11" />
					<TextBlock Text="Stored on device" Foreground="#444444" FontSize="11" />
				</StackPanel>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
