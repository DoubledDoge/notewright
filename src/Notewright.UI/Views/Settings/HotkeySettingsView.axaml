<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Notewright.UI.ViewModels"
	x:Class="Notewright.UI.Views.Settings.HotkeySettingsView"
	x:DataType="vm:SettingsViewModel"
>
	<Grid RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" Padding="24">
			<StackPanel Spacing="24">
				<StackPanel Spacing="4">
					<TextBlock
						Text="Keyboard &amp; hotkeys"
						Foreground="#ffffff"
						FontSize="20"
						FontWeight="Bold"
					/>
					<TextBlock
						Text="Make manual playback feel natural. Set the key that moves your music forward."
						Foreground="#666666"
						FontSize="12"
						TextWrapping="Wrap"
					/>
				</StackPanel>

				<Border
					Background="#141414"
					BorderBrush="#2a2a2a"
					BorderThickness="1"
					CornerRadius="8"
					Padding="16"
				>
					<StackPanel Spacing="12">
						<TextBlock
							Text="Play next chord"
							Foreground="#cccccc"
							FontSize="13"
							FontWeight="SemiBold"
						/>
						<TextBlock Text="Manual mode hotkey" Foreground="#555555" FontSize="11" />

						<Border
							Background="#1a1a1a"
							BorderBrush="#2a2a2a"
							BorderThickness="1"
							CornerRadius="6"
							Padding="16"
						>
							<DockPanel>
								<StackPanel DockPanel.Dock="Right" Spacing="4">
									<Button Command="{Binding ChangeHotkeyCommand}" Classes="secondary">
										✏ Change hotkey
									</Button>
									<StackPanel Orientation="Horizontal" Spacing="4">
										<Ellipse
											Width="6"
											Height="6"
											Fill="#4ade80"
											VerticalAlignment="Center"
											IsVisible="{Binding !HasConflict}"
										/>
										<Ellipse
											Width="6"
											Height="6"
											Fill="#f87171"
											VerticalAlignment="Center"
											IsVisible="{Binding HasConflict}"
										/>
										<TextBlock
											Text="{Binding ConflictStatus}"
											Foreground="#555555"
											FontSize="11"
											VerticalAlignment="Center"
										/>
									</StackPanel>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock
										Text="CURRENT HOTKEY"
										Foreground="#444444"
										FontSize="10"
										FontWeight="SemiBold"
									/>
									<Border
										Background="#2a2a2a"
										CornerRadius="6"
										Padding="16,8"
										HorizontalAlignment="Left"
									>
										<TextBlock
											Text="{Binding CurrentManualHotkey}"
											Foreground="#ffffff"
											FontSize="20"
											FontWeight="Bold"
											FontFamily="Courier New"
										/>
									</Border>
								</StackPanel>
							</DockPanel>
						</Border>

						<StackPanel Spacing="8" IsVisible="{Binding IsChangingHotkey}">
							<TextBox
								Text="{Binding ManualHotkeyInput, UpdateSourceTrigger=PropertyChanged}"
								PlaceholderText="Press a key..."
								MaxLength="1"
								Background="#1a1a1a"
								Foreground="#cccccc"
								BorderBrush="#2a2a2a"
							/>
							<TextBlock
								Text="{Binding HotkeyErrorMessage}"
								Foreground="#f87171"
								FontSize="11"
								IsVisible="{Binding HotkeyErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							/>
						</StackPanel>

						<Button
							Command="{Binding ResetHotkeyCommand}"
							Classes="ghost"
							HorizontalAlignment="Right"
						>
							Reset to =
						</Button>
					</StackPanel>
				</Border>

				<Border
					Background="#141414"
					BorderBrush="#2a2a2a"
					BorderThickness="1"
					CornerRadius="8"
					Padding="16"
				>
					<StackPanel Spacing="12">
						<DockPanel>
							<TextBlock
								DockPanel.Dock="Right"
								Text="Same sheet. Your rhythm."
								Foreground="#444444"
								FontSize="11"
								VerticalAlignment="Center"
							/>
							<TextBlock
								Text="One press. One step."
								Foreground="#cccccc"
								FontSize="13"
								FontWeight="SemiBold"
							/>
						</DockPanel>

						<Border Background="#1a1a1a" CornerRadius="6" Padding="12,8">
							<DockPanel>
								<Border DockPanel.Dock="Right" Background="#2a2a2a" CornerRadius="4" Padding="8,4">
									<TextBlock
										Text="{Binding CurrentManualHotkey}"
										Foreground="#ffffff"
										FontFamily="Courier New"
										FontSize="13"
										FontWeight="Bold"
									/>
								</Border>
								<TextBlock
									Text="Press to advance"
									Foreground="#555555"
									FontSize="11"
									VerticalAlignment="Center"
								/>
							</DockPanel>
						</Border>

						<TextBlock
							Text="The hotkey plays the next note or chord in your sheet. You control the pace; automated playback is unaffected."
							Foreground="#555555"
							FontSize="11"
							TextWrapping="Wrap"
						/>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<Border
			Grid.Row="1"
			Background="#111111"
			BorderBrush="#2a2a2a"
			BorderThickness="0,1,0,0"
			Padding="16,12"
		>
			<DockPanel>
				<Button DockPanel.Dock="Left" Command="{Binding NavigateBackCommand}" Classes="ghost">
					← Back to player
				</Button>

				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
					<Button Command="{Binding CancelCommand}" Classes="secondary">Cancel</Button>
					<Button Command="{Binding SaveHotkeyCommand}" Classes="primary">✓ Save changes</Button>
				</StackPanel>

				<StackPanel
					Orientation="Horizontal"
					Spacing="6"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
				>
					<TextBlock Text="⊙" Foreground="#444444" FontSize="11" />
					<TextBlock Text="Stored on device" Foreground="#444444" FontSize="11" />
				</StackPanel>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
