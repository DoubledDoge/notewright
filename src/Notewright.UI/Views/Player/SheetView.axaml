<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Notewright.UI.ViewModels"
	xmlns:player="using:Notewright.UI.Views.Player"
	xmlns:converters="clr-namespace:Notewright.UI.Converters"
	x:Class="Notewright.UI.Views.Player.SheetView"
	x:DataType="vm:SheetViewModel"
>
	<Border
		Margin="16"
		Background="#141414"
		BorderBrush="#2a2a2a"
		BorderThickness="1"
		CornerRadius="8"
	>
		<DockPanel>
			<Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1">
				<DockPanel>
					<StackPanel
						DockPanel.Dock="Right"
						Orientation="Horizontal"
						Spacing="6"
						VerticalAlignment="Center"
					>
						<Ellipse
							Width="6"
							Height="6"
							Fill="{Binding ValidationStatus, Converter={x:Static converters:ValidationStatusConverters.ToStatusDotColor}}"
						/>
						<TextBlock
							Text="{Binding ValidationStatus, Converter={x:Static converters:ValidationStatusConverters.ToStatusText}}"
							Foreground="{Binding ValidationStatus, Converter={x:Static converters:ValidationStatusConverters.ToStatusColor}}"
							FontSize="11"
							VerticalAlignment="Center"
						/>
					</StackPanel>

					<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
						<TextBlock
							Text="{Binding FileName}"
							Foreground="#cccccc"
							FontSize="12"
							FontWeight="SemiBold"
							VerticalAlignment="Center"
						/>
						<Border Background="#2a2a2a" CornerRadius="3" Padding="4,2">
							<TextBlock Text="EXAMPLE SHEET" Foreground="#666666" FontSize="10" />
						</Border>
					</StackPanel>
				</DockPanel>
			</Border>

			<player:SyntaxLegendView DockPanel.Dock="Bottom" />

			<Border
				DockPanel.Dock="Bottom"
				MaxHeight="120"
				BorderBrush="#2a2a2a"
				BorderThickness="0,1,0,0"
				IsVisible="{Binding Diagnostics.Count, Converter={x:Static converters:PlaybackConverters.IsNonZero}}"
			>
				<ListBox
					ItemsSource="{Binding Diagnostics}"
					SelectionChanged="OnDiagnosticSelected"
					Background="Transparent"
				>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:DiagnosticItem">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock
									Text="{Binding Location}"
									Foreground="#f87171"
									FontFamily="Courier New"
									FontSize="11"
								/>
								<TextBlock
									Text="{Binding Message}"
									Foreground="#cccccc"
									FontSize="11"
									TextWrapping="Wrap"
								/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

			<avaloniaEdit:TextEditor
				x:Name="Editor"
				FontFamily="Courier New, Courier, monospace"
				FontSize="13"
				Background="Transparent"
				Foreground="#cccccc"
				WordWrap="True"
				Padding="12"
			/>
		</DockPanel>
	</Border>
</UserControl>
