<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="Notewright.UI.Views.Player.SyntaxLegendView"
>
	<Border Padding="12,8" BorderBrush="#2a2a2a" BorderThickness="0,1,0,0" Background="#111111">
		<StackPanel Orientation="Horizontal" Spacing="16">
			<TextBlock
				Text="SYNTAX"
				Foreground="#444444"
				FontSize="10"
				FontWeight="SemiBold"
				VerticalAlignment="Center"
			/>

			<StackPanel Orientation="Horizontal" Spacing="4">
				<TextBlock
					Text="q"
					Foreground="#cccccc"
					FontFamily="Courier New"
					FontSize="11"
					VerticalAlignment="Center"
				/>
				<TextBlock
					Text="Single note"
					Foreground="#555555"
					FontSize="11"
					VerticalAlignment="Center"
				/>
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="4">
				<Border Background="#2a2a2a" CornerRadius="2" Padding="4,1">
					<TextBlock Text="[qet]" Foreground="#4ade80" FontFamily="Courier New" FontSize="11" />
				</Border>
				<TextBlock Text="Chord" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="4">
				<TextBlock Text="space" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
				<TextBlock Text="Next beat" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="4">
				<TextBlock
					Text="-"
					Foreground="#cccccc"
					FontFamily="Courier New"
					FontSize="11"
					VerticalAlignment="Center"
				/>
				<TextBlock Text="Rest" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="4">
				<TextBlock
					Text="|"
					Foreground="#cccccc"
					FontFamily="Courier New"
					FontSize="11"
					VerticalAlignment="Center"
				/>
				<TextBlock Text="Bar line" Foreground="#555555" FontSize="11" VerticalAlignment="Center" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
